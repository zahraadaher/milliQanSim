#quick way to get the muon sim to run
/run/initialize

#/gps/verbose 2
/gps/particle fcp
/gps/pos/type Plane
/gps/pos/shape Rectangle
#/gps/pos/centre 290 0 -160 cm
/gps/pos/centre 290 0 -50 cm
#/gps/pos/centre 340 0 -160 cm
/gps/pos/halfx 340 cm
/gps/pos/halfy 575 cm #500cm
#/gps/pos/halfx 10 cm
#/gps/pos/halfy 20 cm #500cm
/gps/pos/rot1 0 1 0
/gps/pos/rot2 0 0 1

# distributions below obtained from integration of interpolated 2D tabulated flux. 
# The flux is taken at the surface of the earth. 
# The rates are for a FCP of mass 0.1 GeV

